index 80ddd056c..b2ebe384c 100644
--- a/lix/libstore/platform/darwin.hh
+++ b/lix/libstore/platform/darwin.hh
@@ -51,6 +51,11 @@ private:
      * even when sandboxing is enabled.
      */
     bool needsHashRewrite() override { return true; };
+
+    /**
+     * Cleans up all System V IPC objects owned by the build user.
+     */
+    void killSandbox(bool getStatus) override;
 };
 
